# --- Application Environment ---
# Set to 'development', 'staging', or 'production'.
# In 'development' or 'staging', schema changes that could cause data loss are automatically applied.
ENVIRONMENT_TYPE=development

# --- Database Connection ---
# Use the format for your specific setup (local vs. container).
# Example for a local MySQL database:
DATABASE_URL="mysql://root:admin@HOST:PORT/DATABASE_NAME"

# --- Gemini API Key ---
API_KEY="AIzaSyDNmRQfF7HwoTnswAtJHibX1h6eyTRmoCQ"

# --- JWT Secret for Authentication ---
# Use a long, random string for security.
JWT_SECRET="6c51050003ee1f94e168e342b86ed6d085ac6a9687f6d48210cf17d0cf686f6244030b8ecc04eaf54b18e17b502d704b24c345dbf886c99d000e33a0f9d6a942"

# --- Server Port ---
PORT=3001

# --- Mailjet Email Service ---
# The sender email must be a verified sender in your Mailjet account.
MAILJET_API_KEY="YOUR_MAILJET_PUBLIC_KEY"
MAILJET_SECRET_KEY="YOUR_MAILJET_SECRET_KEY"
MAILJET_SENDER_EMAIL="YOUR_VERIFIED_SENDER_EMAIL"

# --- Application URLs ---
# This should be the URL where your frontend is running.
FRONTEND_URL=http://localhost:5173  

# --- Initial Admin User (for Database Seeding on first run) ---
INITIAL_ADMIN_EMAIL="raks.tt@gmail.com"
INITIAL_ADMIN_PASSWORD=admin123!


ADMIN_EMAIL="raks.tt@gmail.com"